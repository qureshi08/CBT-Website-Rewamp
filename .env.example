# ============================================
# CBT Website — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# !! This file IS committed and the repository is public. Every value below
# !! is a placeholder. Never put a real secret here — put it in .env.local
# !! and in the deployment platform's environment variables instead.

# Supabase
# The URL and anon key are public by design — they ship in the client bundle
# and are safe here. The service-role key bypasses Row Level Security entirely
# and must NEVER appear in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email — Gmail SMTP via Nodemailer (used by /api/contact)
SMTP_USER=your-gmail-address
SMTP_PASS=your-gmail-app-password
EMAIL_TO=book_a_call@convergentbt.com
EMAIL_TO_PBI=pbi_contact_form@convergentbt.com

# Email — Resend (legacy; still used by /api/partner)
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=noreply@convergentbt.com

# App
NEXT_PUBLIC_SITE_URL=https://convergentbt.com

# ---------------------------------------------------------------------------
# Anti-spam (docs/SECURITY_PLAN.md finding 3)
# Both blocks are OPTIONAL. Leave them unset and the forms still work — the
# honeypot, time-trap, content heuristics and origin check all run regardless.
# ---------------------------------------------------------------------------

# Cloudflare Turnstile. Unset = widget is not rendered and the server skips
# token verification. Set both to switch the layer on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis, for per-IP rate limiting. Unset = an in-memory counter is used
# instead, which only holds within a single server instance (so it is partial
# cover on Vercel). Set both for durable cross-instance limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing client IPs in the abuse log (form_abuse_log.ip_hash).
# Any random string of 16+ characters, e.g. `openssl rand -hex 32`.
# Unset = IPs are not recorded at all. This is deliberate: an unsalted hash of
# an IPv4 address is trivially reversible, so it would be a raw IP in disguise.
# Changing it later breaks correlation with rows written under the old salt.
ABUSE_LOG_SALT=
